   "id": "afb-01",
   "turns": [
    {
     "text": "شلون الحال، هذا متوفر؟"
    }
   ]
  },
  {
   "id": "afb-02",
   "turns": [
    {
     "text": "بكم هذا الثوب؟ ابي اعرف"
    }
   ]
  },
  {
   "id": "afb-03",
   "turns": [
    {
     "text": "ابي اثنين مقاس وسط"
    }
   ]
  },
  {
   "id": "afb-04",
   "turns": [
    {
     "text": "في توصيل للعين؟ وش المدة؟"
    }
   ]
  },
  {
   "id": "afb-05",
   "turns": [
    {
     "text": "عندكم دفع عند الاستلام ولا لازم تحويل الحين؟"
    }
   ]
  },
  {
   "id": "afb-06",
   "turns": [
    {
     "text": "حولت لك المبلغ الحين، شوف الصورة"
    }
   ]
  },
  {
   "id": "afb-07",
   "turns": [
    {
     "text": "هذا موجود باللون الأحمر؟ ودي فيه"
    }
   ]
  },
  {
   "id": "afb-08",
   "turns": [
    {
     "text": "عطني خصم شوي"
    }
   ]
  },
  {
   "id": "afb-09",
   "turns": [
    {
     "text": "هلا"
    },
    {
     "text": "وين محلكم؟"
    }
   ]
  },
  {
   "id": "afb-10",
   "turns": [
    {
     "text": "متى يوصل طلبي؟ ابي اعرف"
    }
   ]
  },
  {
   "id": "afb-v1",
   "turns": [
    {
     "voice": "voice/afb-v1.ogg",
     "transcript": "ابي هذا الثوب، متى ترسلونه؟"
    }
   ]
  },
  {
   "id": "afb-v2",
   "turns": [
    {
     "voice": "voice/afb-v2.ogg",
     "transcript": "هلا والله، المحل مفتوح لين متى اليوم؟"
