# Chatfront configuration. Copy to api/.env for local work (an empty value means the default);
# on Render, set these in the service's Environment page. Real values never go into git, chat or the spec doc.

# --- App -----------------------------------------------------------------------------------
# dev, test or prod. prod refuses to start with the development secrets below.
ENV=dev
# The public address of the app, used in signed media links. Render: https://<service>.onrender.com
PUBLIC_BASE_URL=http://localhost:8000
# Where the web app lives, for shop and owner links sent in chats. Empty means PUBLIC_BASE_URL;
# set it to the GitHub Pages address when the web app is hosted there.
WEB_BASE_URL=
LOG_LEVEL=INFO

# --- Database (Neon) -------------------------------------------------------------------------
# Neon dashboard > your project > Connection details > choose the DIRECT connection (not
# "Pooled"), role neondb_owner. Paste it whole; the app adds the asyncpg driver itself.
# Migrations create the chatfront_app role that tenant work runs as (row-level security).
DATABASE_URL=postgresql+asyncpg://chatfront_owner:owner@127.0.0.1:5432/chatfront
DB_POOL_SIZE=5

# --- Secrets the app makes for itself --------------------------------------------------------
# Any long random strings (32+ characters): `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Render generates these from render.yaml. Never change them after launch: every stored phone
# hash depends on PHONE_HASH_KEY, and SECRET_KEY seals each shop's receipt signing key and the
# wallet SMS kept as evidence.
SECRET_KEY=dev-only-secret-key-change-me-0000000000
PHONE_HASH_KEY=dev-only-phone-hash-key-change-me-00000
# Sent by cron-job.org as the X-Cron-Secret header to POST /internal/cron, every 5 minutes
# (the payment watcher runs at that pace).
CRON_SECRET=dev-only-cron-secret

# --- Meta: WhatsApp Cloud API, Instagram, Messenger --------------------------------------------
# developers.facebook.com > My Apps > your app > App settings > Basic > App secret.
META_APP_SECRET=
# Any string you choose; type the same one into WhatsApp > Configuration > Webhook > Verify token.
META_VERIFY_TOKEN=
# Business portfolio > Settings > Users > System users > Generate token (whatsapp_business_messaging,
# whatsapp_business_management). The app's temporary token expires in a day; this one does not.
WHATSAPP_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
META_GRAPH_BASE_URL=https://graph.facebook.com
# Owner alerts (low stock, expiry) outside WhatsApp's 24-hour window: WhatsApp Manager >
# Message templates > Create, category Utility, body "Chatfront alert for your shop: {{1}}".
# Put its name here once Meta approves it; until then those alerts wait in the console.
WHATSAPP_ALERT_TEMPLATE=
WHATSAPP_ALERT_TEMPLATE_LANG=en
# The owner panel's product form: WhatsApp Manager > Flows > Create flow, paste
# api/src/chatfront/stock/flows/edit_product.json, publish, and put the Flow ID here.
# Without it the panel works with lists and buttons.
WHATSAPP_FLOW_PRODUCT_ID=
# Instagram DMs (Instagram API with Instagram Login): your app > Instagram > API setup with
# Instagram login. The Instagram app secret signs Instagram webhooks; the token is the one
# "Generate token" gives for the shop's Instagram professional account. The same token reads
# the shop's past posts for the console's Instagram import (feature 84).
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com
# Facebook Messenger: your app > Messenger > Messenger API settings > Generate a Page access
# token for the shop's Facebook Page.
MESSENGER_PAGE_ACCESS_TOKEN=
# Meta Commerce catalog (feature 6): Business Settings > System users > your system user >
# Generate token, with catalog_management (and business_management), after the catalog is
# assigned to that system user. Used for shops connected with python -m chatfront.catalog.meta
# without a token of their own; the console's Meta catalog import (feature 85) reads with it.
META_CATALOG_TOKEN=

# --- Link checks (feature 40, optional) ---------------------------------------------------------
# Code already catches fake WhatsApp/Meta/wallet links on its own. With this key, links in
# chats are also checked against Google's lists of phishing and malware sites. Google Cloud
# console > a project > APIs & Services > Library > "Safe Browsing API" > Enable, then
# Credentials > Create credentials > API key (restrict it to the Safe Browsing API). Free, and
# Google allows it for non-commercial use only: fine for the hackathon demo; a shop that pays
# would move to Google Web Risk. Leave empty and only code checks links.
SAFE_BROWSING_API_KEY=
SAFE_BROWSING_URL=https://safebrowsing.googleapis.com/v4/threatMatches:find

# --- Models ------------------------------------------------------------------------------------
# auto: call a provider when its key is set, the mock otherwise (never the mock when ENV=prod).
# mock: always the mock (tests, CI, and a deploy whose model keys have not come yet: its
# replies say they are recorded). /health shows which: mock, live, or no keys.
AI_MODE=auto
# Baseten > Settings > API keys. The participant guide (section 6) names the hackathon model
# meta-models/muse-spark-open-1026, not the docs' meta-models/muse-spark-open.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
SPARK_MODEL_BASETEN=meta-models/muse-spark-open-1026
# Fireworks > Account > API keys. Second in line when Baseten fails.
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
SPARK_MODEL_FIREWORKS=accounts/fireworks/models/muse-spark-open
# Our Muse Glimmer deployment on Modal (vLLM, OpenAI-compatible): its URL ending in /v1, and
# the API key it was started with. Leave empty and the watcher uses Spark Open instead.
MODAL_GLIMMER_BASE_URL=
MODAL_GLIMMER_API_KEY=
GLIMMER_MODEL=meta-models/Muse-Glimmer-30B
# The Meta Model API upgrade path (off: dev.meta.ai is not reachable from Pakistan).
META_MODEL_API_ENABLED=false
META_MODEL_API_KEY=
META_MODEL_API_BASE_URL=
META_SPARK_MODEL=muse-spark-1.3
AI_TIMEOUT_SECONDS=60
# Rupees per US dollar, for the cost meter.
USD_TO_PKR=280
# Set to a folder to save live model answers as candidate mock fixtures.
AI_RECORD_DIR=

# --- Media (Supabase Storage) -------------------------------------------------------------------
# local keeps files in .media/ (development). supabase for Render.
STORAGE_BACKEND=local
# Where local files go (absolute path); empty means .media/ at the repo root.
LOCAL_MEDIA_DIR=
# Supabase > Project settings > API > Project URL, and the service_role key (server only).
# Create a PRIVATE bucket named chatfront-media under Storage first.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=chatfront-media
MAX_UPLOAD_BYTES=20971520
SIGNED_URL_TTL_SECONDS=3600

# --- Behaviour -----------------------------------------------------------------------------------
WORKER_ENABLED=true
WORKER_POLL_SECONDS=1.0
WORKER_BATCH_SIZE=5
PUBLIC_RATE_LIMIT_PER_MINUTE=30
# The frontend's address when it is hosted apart from the API, e.g. https://ahsaanmunir53.github.io
# (comma-separated for more than one). Empty when the API serves the web app itself.
CORS_ORIGINS=

# --- Paths (only change these for unusual layouts; empty means the repo defaults) -----------
I18N_DIR=
WEB_DIST_DIR=
