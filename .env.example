# Chatfront configuration. Copy to api/.env for local work (an empty value means the default);
# on Render, set these in the service's Environment page. Real values never go into git, chat or the spec doc.

# --- App -----------------------------------------------------------------------------------
# dev, test or prod. prod refuses to start with the development secrets below.
ENV=dev
# The public address of the app, used in signed media links. Render: https://<service>.onrender.com
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# --- Database (Neon) -------------------------------------------------------------------------
# Neon dashboard > your project > Connection details > choose the DIRECT connection (not
# "Pooled"), role neondb_owner. Paste it whole; the app adds the asyncpg driver itself.
# Migrations create the chatfront_app role that tenant work runs as (row-level security).
DATABASE_URL=postgresql+asyncpg://chatfront_owner:owner@127.0.0.1:5432/chatfront
DB_POOL_SIZE=5

# --- Secrets the app makes for itself --------------------------------------------------------
# Any long random strings (32+ characters): `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Render generates these from render.yaml. Never change PHONE_HASH_KEY after launch: every
# stored phone hash depends on it.
SECRET_KEY=dev-only-secret-key-change-me-0000000000
PHONE_HASH_KEY=dev-only-phone-hash-key-change-me-00000
# Sent by cron-job.org as the X-Cron-Secret header to POST /internal/cron.
CRON_SECRET=dev-only-cron-secret

# --- Meta: WhatsApp Cloud API, Instagram, Messenger --------------------------------------------
# developers.facebook.com > My Apps > your app > App settings > Basic > App secret.
META_APP_SECRET=
# Any string you choose; type the same one into WhatsApp > Configuration > Webhook > Verify token.
META_VERIFY_TOKEN=
# Business portfolio > Settings > Users > System users > Generate token (whatsapp_business_messaging,
# whatsapp_business_management). The app's temporary token expires in a day; this one does not.
WHATSAPP_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
META_GRAPH_BASE_URL=https://graph.facebook.com

# --- Models ------------------------------------------------------------------------------------
# auto: call a provider when its key is set, the mock otherwise (never the mock when ENV=prod).
# mock: always the mock (tests, CI).
AI_MODE=auto
# Baseten > Settings > API keys. Muse Spark Open model slug from Baseten's model page.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
SPARK_MODEL_BASETEN=meta-models/muse-spark-open
# Fireworks > Account > API keys. Second in line when Baseten fails.
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
SPARK_MODEL_FIREWORKS=accounts/fireworks/models/muse-spark-open
# Our Muse Glimmer deployment on Modal (vLLM, OpenAI-compatible): its URL ending in /v1, and
# the API key it was started with. Leave empty and the watcher uses Spark Open instead.
MODAL_GLIMMER_BASE_URL=
MODAL_GLIMMER_API_KEY=
GLIMMER_MODEL=meta-models/Muse-Glimmer-30B
# The Meta Model API upgrade path (off: dev.meta.ai is not reachable from Pakistan).
META_MODEL_API_ENABLED=false
META_MODEL_API_KEY=
META_MODEL_API_BASE_URL=
META_SPARK_MODEL=muse-spark-1.3
AI_TIMEOUT_SECONDS=60
# Rupees per US dollar, for the cost meter.
USD_TO_PKR=280
# Set to a folder to save live model answers as candidate mock fixtures.
AI_RECORD_DIR=

# --- Media (Supabase Storage) -------------------------------------------------------------------
# local keeps files in .media/ (development). supabase for Render.
STORAGE_BACKEND=local
# Where local files go (absolute path); empty means .media/ at the repo root.
LOCAL_MEDIA_DIR=
# Supabase > Project settings > API > Project URL, and the service_role key (server only).
# Create a PRIVATE bucket named chatfront-media under Storage first.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=chatfront-media
MAX_UPLOAD_BYTES=20971520
SIGNED_URL_TTL_SECONDS=3600

# --- Behaviour -----------------------------------------------------------------------------------
WORKER_ENABLED=true
WORKER_POLL_SECONDS=1.0
WORKER_BATCH_SIZE=5
PUBLIC_RATE_LIMIT_PER_MINUTE=30

# --- Paths (only change these for unusual layouts; empty means the repo defaults) -----------
I18N_DIR=
WEB_DIST_DIR=
